<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: match the in-app splash background so the hand-off is seamless. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/piqx_surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/piqx_surface</item>
    </style>
</resources>
